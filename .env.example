GENERATED_OUTPUTS_DIR=./data/outputs

# Wan 2.2 / Fal.ai Integration (Optional for Stage 10)
FAL_KEY=

# Default Adapter: 'simulated' or 'wan_i2v'
DEFAULT_ADAPTER=simulated

# Gemini 3.8 Flash Video Blueprint Planner
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
